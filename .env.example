# AgriShield — ortam değişkenleri
# Bu dosyayı .env olarak kopyalayın. Gizli anahtarları SADECE .env.local'a yazın.

DATABASE_URL="file:./dev.db"
DB_PROVIDER=sqlite             # sqlite | postgres (postgres için DATABASE_URL'i değiştirip `npm run db:generate` çalıştırın)
OFFLINE=1                      # 1: tüm dış servisler taklit (zincir, SMS, AI)
DEMO_SEED=2025-sanliurfa       # seed senaryosu
CHAIN_MODE=mock                # mock | amoy
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
AMOY_PRIVATE_KEY=              # SADECE testnet cüzdanı, .env.local'da, repoya asla girmez
CONTRACT_ADDRESS=
AI_MODE=local                  # local (bilgi tabanı) | api (Anthropic)
ANTHROPIC_API_KEY=             # SADECE .env.local
ANTHROPIC_MODEL=claude-opus-5
SMS_MODE=mock                  # mock | provider
SMS_WEBHOOK_URL=               # provider modunda: POST {to, text} alan kendi SMS köprünüz
SMS_TEST_NUMBER=               # provider modunda yalnızca takımın kendi numarası
OPERATOR_PIN=1907              # /operator girişi
INGEST_SECRET=degistir-bunu    # ESP32 HMAC anahtarı (.env.local'da değiştirin)
ITIRAZ_PENCERESI_SN=5          # karar sonrası itiraz penceresi (sahnede 5, gerçekte 60)
INGEST_INTERVAL_SN=2           # ESP32'ye dönülen ölçüm aralığı (sahnede 2, sahada 900 = 15 dk)
DEVICE_SIM=1                   # 1: gerçek cihaz 20 sn sessizse simüle cihaz devreye girer
VILLAGE_DAILY_CAP=25           # devre kesici: köy başına günde en fazla N parsel ödemesi
PUBLIC_BASE_URL=http://localhost:3000   # QR kodlarının göstereceği adres (kendi alan adınız)
NEXT_PUBLIC_STAGE_MODE=1       # sahne (koyu, dev tipografi) varsayılan
