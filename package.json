{
  "name": "agrishield-web",
  "version": "1.0.0",
  "private": true,
  "description": "AgriShield — parametrik kuraklık sigortası altyapısı: sahne demosu, karar motoru, kanıt sayfası, 3D saha simülatörü (TEKNOFEST 2026, AlgoVest)",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start -p 3000",
    "stage": "cross-env OFFLINE=1 CHAIN_MODE=mock AI_MODE=local NEXT_PUBLIC_STAGE_MODE=1 next start -p 3000",
    "setup": "npm run db:generate && prisma migrate deploy && npm run seed",
    "db:generate": "tsx scripts/prisma-generate.ts",
    "seed": "tsx scripts/seed.ts",
    "data:generate": "tsx scripts/generate-data.ts",
    "fetch:weather": "tsx scripts/fetch-weather.ts",
    "fetch:sentinel": "tsx scripts/fetch-sentinel.ts",
    "dry-run": "tsx scripts/dry-run.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "lint": "tsc --noEmit && tsx scripts/lint-facts.ts",
    "lint:facts": "tsx scripts/lint-facts.ts",
    "typecheck": "tsc --noEmit",
    "perf": "tsx scripts/perf.ts",
    "qr": "tsx scripts/qr.ts",
    "device:emulate": "tsx scripts/device-emulator.ts",
    "fonts": "tsx scripts/build-fonts.ts",
    "screens": "tsx scripts/screens.ts",
    "contract:compile": "tsx scripts/compile-contract.ts",
    "contract:deploy": "tsx scripts/deploy-amoy.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "ethers": "^6.17.0",
    "lucide-react": "^1.48.0",
    "motion": "^12.43.0",
    "next": "^15.5.26",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "cross-env": "^10.1.0",
    "lighthouse": "^12.8.2",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "solc": "^0.8.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
